        colors = {'merla': '#2E86AB', 'pems': '#A23B72'}

        # Row 1: Privacy-Utility Tradeoff
        ax1 = fig.add_subplot(gs[0, 0])
        for dataset_name in ['merla', 'pems']:
            data = self.results[dataset_name]['privacy']
            finite_eps = data[data['epsilon'] != float('inf')]
