class DatasetProcessor:
    """Universal processor for both MERLA and PeMS datasets"""

    def __init__(self, file_path, dataset_name):
        self.file_path = file_path
        self.dataset_name = dataset_name
        self.scaler = StandardScaler()

        if not os.path.exists(file_path):
            if 'merla' in dataset_name.lower():
                generate_synthetic_merla_dataset(save_path=file_path)
            else:
                generate_synthetic_pems_dataset(save_path=file_path)

    def load_and_preprocess(self):
        """Load and preprocess dataset"""
        df = pd.read_csv(self.file_path)
        df['timestamp'] = pd.to_datetime(df['timestamp'])

        # Extract temporal features
        df['hour'] = df['timestamp'].dt.hour
        df['day_of_week'] = df['timestamp'].dt.dayofweek
        df['sin_hour'] = np.sin(2 * np.pi * df['hour'] / 24)
        df['cos_hour'] = np.cos(2 * np.pi * df['hour'] / 24)
        df['peak_hour'] = ((df['hour'] >= 7) & (df['hour'] <= 9) |
                          (df['hour'] >= 17) & (df['hour'] <= 19)).astype(int)
        df['weekend_factor'] = np.where(df['day_of_week'] >= 5, 0.7, 1.0)
        df['normalized_speed'] = df['speed'] / df['speed'].max()
        df['congestion'] = df['flow'] / df['capacity']

        features = ['flow', 'congestion', 'normalized_speed', 'hour',
                   'sin_hour', 'cos_hour', 'peak_hour', 'weekend_factor',
                   'occupancy', 'capacity']

        data = df[features].values
        data = self.scaler.fit_transform(data)

        return data

    def generate_noniid_splits(self, data, num_clients=5, heterogeneity=0.5):
        """Generate non-IID data splits"""
        total_samples = len(data)
        alpha = 1.0 / heterogeneity if heterogeneity > 0 else 1000
        proportions = np.random.dirichlet([alpha] * num_clients)

        client_data = []
        indices = np.arange(total_samples)
        start_idx = 0

        for i, prop in enumerate(proportions):
            num_samples = int(prop * total_samples)
            shift = int(i * (24 * 60 / 5) * heterogeneity)
            shifted_indices = (indices[start_idx:start_idx + num_samples] + shift) % total_samples

            client_samples = data[shifted_indices]
            noise = np.random.normal(0, 0.05 * heterogeneity, client_samples.shape)
            client_samples = client_samples + noise

            client_data.append(client_samples)
            start_idx += num_samples

        return client_data


def create_sequences(data, seq_length=20):
    """Create time series sequences"""
    X, y = [], []
    for i in range(len(data) - seq_length):
        X.append(data[i:i+seq_length])
        y.append(data[i+seq_length, 0])
    return np.array(X), np.array(y)


