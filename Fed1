        ax4.axhline(y=20, color='red', linestyle='--', alpha=0.5, linewidth=2, label='20% Threshold')
        ax4.set_xlabel('Outage Scenario', fontsize=11, fontweight='bold')
        ax4.set_ylabel('Performance Degradation (%)', fontsize=11, fontweight='bold')
        ax4.set_title('Outage Impact Comparison', fontsize=13, fontweight='bold')
        ax4.set_xticks(x)
        ax4.set_xticklabels(scenarios, rotation=45, ha='right')
        ax4.legend(fontsize=10)
        ax4.grid(True, alpha=0.3, axis='y')

        # Recovery performance
        ax5 = fig.add_subplot(gs[1, 1])
        scenarios = self.results['merla']['outage']['scenario']
        x = np.arange(len(scenarios))
        width = 0.25

        ax5.bar(x - width, self.results['merla']['outage']['baseline_mae'], width,
