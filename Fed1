def generate_synthetic_merla_dataset(num_samples=8640, save_path='merla_dataset.csv'):
    """Generate synthetic MERLA-like dataset (European traffic patterns)"""
    start_time = pd.Timestamp('2023-01-01 00:00:00')
    timestamps = [start_time + pd.Timedelta(minutes=5*i) for i in range(num_samples)]

    data = []
    for i, ts in enumerate(timestamps):
        hour = ts.hour
        day_of_week = ts.dayofweek

        # European traffic patterns (more gradual peaks)
        morning_rush = np.exp(-((hour - 8)**2) / 4)
        evening_rush = np.exp(-((hour - 17)**2) / 4)
        base_flow = 0.3 + 0.4 * morning_rush + 0.3 * evening_rush

        weekend_factor = 0.7 if day_of_week >= 5 else 1.0

        flow = base_flow * weekend_factor * 1000 + np.random.normal(0, 100)
        flow = max(0, flow)

        base_speed = 60
        congestion_factor = min(1.0, flow / 2000)
        speed = base_speed * (1 - congestion_factor * 0.6) + np.random.normal(0, 5)
        speed = max(10, min(80, speed))

        capacity = 2000

        data.append({
            'timestamp': ts,
            'flow': flow,
            'speed': speed,
            'capacity': capacity,
            'occupancy': flow / capacity
        })

    df = pd.DataFrame(data)
    df.to_csv(save_path, index=False)
    print(f"✓ Generated MERLA dataset: {len(df)} samples")
    return df


def generate_synthetic_pems_dataset(num_samples=8640, save_path='pems_dataset.csv'):
    """Generate synthetic PeMS-like dataset (California traffic patterns)"""
    start_time = pd.Timestamp('2023-01-01 00:00:00')
    timestamps = [start_time + pd.Timedelta(minutes=5*i) for i in range(num_samples)]

    data = []
    for i, ts in enumerate(timestamps):
        hour = ts.hour
        day_of_week = ts.dayofweek

        # California traffic patterns (sharper peaks, more congestion)
        morning_rush = np.exp(-((hour - 7.5)**2) / 3)
        midday = np.exp(-((hour - 12)**2) / 6) * 0.4
        evening_rush = np.exp(-((hour - 17.5)**2) / 2.5)
        base_flow = 0.4 + 0.45 * morning_rush + midday + 0.5 * evening_rush

        weekend_factor = 0.8 if day_of_week >= 5 else 1.0

        flow = base_flow * weekend_factor * 1200 + np.random.normal(0, 120)
        flow = max(0, flow)

        base_speed = 65
        congestion_factor = min(1.0, flow / 2200)
        speed = base_speed * (1 - congestion_factor * 0.7) + np.random.normal(0, 6)
        speed = max(5, min(75, speed))

        capacity = 2200

        # PeMS has occupancy data
        occupancy = min(1.0, flow / (capacity * 1.2))

        data.append({
            'timestamp': ts,
            'flow': flow,
            'speed': speed,
            'capacity': capacity,
            'occupancy': occupancy
        })

    df = pd.DataFrame(data)
    df.to_csv(save_path, index=False)
    print(f"✓ Generated PeMS dataset: {len(df)} samples")
    return df


# ============================================================================
# NEURAL NETWORK MODEL
# ============================================================================

class EnhancedFederatedLSTM(nn.Module):
    """Enhanced LSTM with attention for traffic prediction"""

    def __init__(self, input_size=10, hidden_size=128, num_layers=3,
                 num_heads=8, dropout=0.2):
        super(EnhancedFederatedLSTM, self).__init__()

        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=num_layers,
            batch_first=True,
            bidirectional=True,
            dropout=dropout if num_layers > 1 else 0
        )

        self.attention = nn.MultiheadAttention(
            embed_dim=hidden_size * 2,
            num_heads=num_heads,
            dropout=dropout,
            batch_first=True
        )

        self.layer_norm = nn.LayerNorm(hidden_size * 2)

        self.feature_extractor = nn.Sequential(
            nn.Linear(input_size, 64),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(64, 32)
        )

        self.output_layers = nn.Sequential(
            nn.Linear(hidden_size * 2 + 32, 128),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(64, 1)
        )

    def forward(self, x):
        batch_size = x.size(0)

        lstm_out, _ = self.lstm(x)
        lstm_out = self.layer_norm(lstm_out)

        attn_out, _ = self.attention(lstm_out, lstm_out, lstm_out)
        last_hidden = attn_out[:, -1, :]

        features = self.feature_extractor(x[:, -1, :])
        combined = torch.cat([last_hidden, features], dim=1)
        output = self.output_layers(combined)

        return output


