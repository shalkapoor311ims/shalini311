        ax7.legend(fontsize=10)
        ax7.grid(True, alpha=0.3)

        # Convergence comparison
        ax8 = fig.add_subplot(gs[2, 1])
        hetero_levels = self.results['merla']['noniid']['heterogeneity']
        x = np.arange(len(hetero_levels))
        width = 0.35
        ax8.bar(x - width/2, self.results['merla']['noniid']['convergence_rounds'], width,
               label='MERLA', color=colors['merla'], alpha=0.8)
        ax8.bar(x + width/2, self.results['pems']['noniid']['convergence_rounds'], width,
               label='PeMS', color=colors['pems'], alpha=0.8)
        ax8.set_xlabel('Data Heterogeneity', fontsize=11, fontweight='bold')
        ax8.set_ylabel('Convergence Rounds', fontsize=11, fontweight='bold')
        ax8.set_title('Convergence Speed', fontsize=13, fontweight='bold')
        ax8.set_xticks(x)
        ax8.set_xticklabels([f'{h:.1f}' for h in hetero_levels])
        ax8.legend(fontsize=10)
        ax8.grid(True, alpha=0.3, axis='y')

        # Overall comparison radar chart
        ax9 = fig.add_subplot(gs[2, 2], projection='polar')

        # Metrics (normalized to 0-100 scale)
        categories = ['Privacy\nPreservation', 'Outage\nResilience',
                     'Non-IID\nHandling', 'Convergence\nSpeed', 'Accuracy']

        # MERLA scores
        merla_scores = [
            100 - ((self.results['merla']['privacy'][self.results['merla']['privacy']['epsilon'] == 1.0]['mae'].values[0] -
                   self.results['merla']['privacy'][self.results['merla']['privacy']['epsilon'] == float('inf')]['mae'].values[0]) /
                   self.results['merla']['privacy'][self.results['merla']['privacy']['epsilon'] == float('inf')]['mae'].values[0] * 100),
            merla_resilience,
            100 - (self.results['merla']['noniid']['mae'].max() / self.results['merla']['noniid']['mae'].min() - 1) * 100,
            100 - (self.results['merla']['noniid']['convergence_rounds'].mean() / 50 * 100),
            self.results['merla']['privacy'][self.results['merla']['privacy']['epsilon'] == float('inf')]['r2'].values[0] * 100
        ]

        # PeMS scores
        pems_scores = [
            100 - ((self.results['pems']['privacy'][self.results['pems']['privacy']['epsilon'] == 1.0]['mae'].values[0] -
                   self.results['pems']['privacy'][self.results['pems']['privacy']['epsilon'] == float('inf')]['mae'].values[0]) /
                   self.results['pems']['privacy'][self.results['pems']['privacy']['epsilon'] == float('inf')]['mae'].values[0] * 100),
            pems_resilience,
            100 - (self.results['pems']['noniid']['mae'].max() / self.results['pems']['noniid']['mae'].min() - 1) * 100,
            100 - (self.results['pems']['noniid']['convergence_rounds'].mean() / 50 * 100),
            self.results['pems']['privacy'][self.results['pems']['privacy']['epsilon'] == float('inf')]['r2'].values[0] * 100
        ]

        # Normalize to ensure all values are between 0-100
        merla_scores = [max(0, min(100, score)) for score in merla_scores]
        pems_scores = [max(0, min(100, score)) for score in pems_scores]

        # Number of variables
        N = len(categories)
        angles = [n / float(N) * 2 * np.pi for n in range(N)]
        merla_scores += merla_scores[:1]
        pems_scores += pems_scores[:1]
        angles += angles[:1]

        ax9.plot(angles, merla_scores, 'o-', linewidth=2, color=colors['merla'], label='MERLA')
        ax9.fill(angles, merla_scores, alpha=0.25, color=colors['merla'])
        ax9.plot(angles, pems_scores, 'o-', linewidth=2, color=colors['pems'], label='PeMS')
        ax9.fill(angles, pems_scores, alpha=0.25, color=colors['pems'])

        ax9.set_xticks(angles[:-1])
        ax9.set_xticklabels(categories, fontsize=9)
        ax9.set_ylim(0, 100)
        ax9.set_title('Overall Performance Comparison', fontsize=13, fontweight='bold', pad=20)
        ax9.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1), fontsize=10)
        ax9.grid(True)

        plt.suptitle('MERLA vs PeMS: Comprehensive Federated Learning Comparison',
                    fontsize=16, fontweight='bold', y=0.995)

        return fig

