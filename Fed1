class ComparativeExperimentSuite:
    """Run experiments on both datasets with comparisons"""

    def __init__(self, device='cpu'):
        self.device = device
        self.results = {'merla': {}, 'pems': {}}

    def run_privacy_experiment(self, data, dataset_name, epsilon_values=[0.5, 1.0, 2.0, float('inf')]):
        """Privacy-utility tradeoff experiment"""
        print(f"\n{'='*70}")
        print(f"Privacy Experiment - {dataset_name.upper()}")
        print(f"{'='*70}")

        results = []

        for epsilon in epsilon_values:
            print(f"\nTesting ε = {epsilon}")

            model = EnhancedFederatedLSTM(input_size=10).to(self.device)
            optimizer = torch.optim.Adam(model.parameters(), lr=0.001)

            X, y = create_sequences(data)
            X = torch.FloatTensor(X).to(self.device)
            y = torch.FloatTensor(y).unsqueeze(1).to(self.device)

            split = int(0.8 * len(X))
            X_train, y_train = X[:split], y[:split]
            X_test, y_test = X[split:], y[split:]

            model.train()
            for epoch in range(10):
                total_loss = 0
                for i in range(0, len(X_train), 32):
                    batch_X = X_train[i:i+32]
                    batch_y = y_train[i:i+32]

                    optimizer.zero_grad()
                    output = model(batch_X)
                    loss = F.mse_loss(output, batch_y)
                    loss.backward()

                    # Add DP noise
                    if epsilon != float('inf'):
                        sigma = np.sqrt(2 * np.log(1.25/1e-5)) / epsilon
                        with torch.no_grad():
                            for param in model.parameters():
                                if param.grad is not None:
                                    noise = torch.normal(0, sigma, size=param.grad.shape).to(self.device)
                                    param.grad += noise

                    optimizer.step()
                    total_loss += loss.item()

            model.eval()
            with torch.no_grad():
                predictions = model(X_test).cpu().numpy()
                y_test_np = y_test.cpu().numpy()

                mae = mean_absolute_error(y_test_np, predictions)
                rmse = np.sqrt(mean_squared_error(y_test_np, predictions))
                r2 = r2_score(y_test_np, predictions)

            print(f"  MAE: {mae:.4f}, RMSE: {rmse:.4f}, R²: {r2:.4f}")

            results.append({
                'epsilon': epsilon,
                'mae': mae,
                'rmse': rmse,
                'r2': r2
            })

        return pd.DataFrame(results)

    def run_outage_experiment(self, data, dataset_name, num_clients=5):
        """Outage resilience experiment"""
        print(f"\n{'='*70}")
        print(f"Outage Experiment - {dataset_name.upper()}")
        print(f"{'='*70}")

        processor = DatasetProcessor(f'{dataset_name}_dataset.csv', dataset_name)
        client_data = processor.generate_noniid_splits(data, num_clients)

        clients = []
        for i, cdata in enumerate(client_data):
            model = EnhancedFederatedLSTM(input_size=10)
            client = FederatedClient(i, cdata, model, self.device)
            clients.append(client)

        server_model = EnhancedFederatedLSTM(input_size=10)
        server = FederatedServer(server_model, clients, self.device)

        # Baseline training
        print("Training baseline...")
        for round_num in range(20):
            server.train_round(num_clients_per_round=num_clients)

        baseline_metrics = server.evaluate(data[-1000:])
        baseline_mae = baseline_metrics['mae']

        # Test outage scenarios
        scenarios = [
            {'name': '20% Outage', 'clients': 1},
            {'name': '40% Outage', 'clients': 2},
            {'name': '60% Outage', 'clients': 3}
        ]

        results = []

        for scenario in scenarios:
            print(f"\nTesting: {scenario['name']}")

            affected = np.random.choice(num_clients, scenario['clients'], replace=False)
            for idx in affected:
                clients[idx].active = False

            metrics_during = server.evaluate(data[-1000:])
            degradation = ((metrics_during['mae'] - baseline_mae) / baseline_mae) * 100

            print(f"  Degradation: {degradation:.2f}%")

            for idx in affected:
                clients[idx].active = True

            for _ in range(10):
                server.train_round()

            metrics_recovered = server.evaluate(data[-1000:])

            results.append({
                'scenario': scenario['name'],
                'baseline_mae': baseline_mae,
                'outage_mae': metrics_during['mae'],
                'recovered_mae': metrics_recovered['mae'],
                'degradation': degradation
            })

        return pd.DataFrame(results)

    def run_noniid_experiment(self, data, dataset_name, heterogeneity_levels=[0.1, 0.5, 0.9]):
        """Non-IID data experiment"""
        print(f"\n{'='*70}")
        print(f"Non-IID Experiment - {dataset_name.upper()}")
        print(f"{'='*70}")

        processor = DatasetProcessor(f'{dataset_name}_dataset.csv', dataset_name)
        results = []

        for hetero in heterogeneity_levels:
            print(f"\nHeterogeneity: {hetero}")

            client_data = processor.generate_noniid_splits(data, 5, hetero)

            clients = []
            for i, cdata in enumerate(client_data):
                model = EnhancedFederatedLSTM(input_size=10)
                client = FederatedClient(i, cdata, model, self.device)
                clients.append(client)

            server_model = EnhancedFederatedLSTM(input_size=10)
            server = FederatedServer(server_model, clients, self.device)

            convergence_round = None
            prev_mae = float('inf')

            for round_num in range(50):
                server.train_round()

                if (round_num + 1) % 5 == 0:
                    metrics = server.evaluate(data[-1000:])
                    mae = metrics['mae']

                    if convergence_round is None and abs(prev_mae - mae) < 0.01:
                        convergence_round = round_num + 1

                    prev_mae = mae

            final_metrics = server.evaluate(data[-1000:])

            print(f"  Final MAE: {final_metrics['mae']:.4f}")
            print(f"  Convergence: {convergence_round or '>50'} rounds")

            results.append({
                'heterogeneity': hetero,
                'mae': final_metrics['mae'],
                'convergence_rounds': convergence_round or 50
            })

        return pd.DataFrame(results)

    def run_all_experiments(self):
        """Run all experiments on both datasets"""
        print("\n" + "="*80)
        print(" "*20 + "MULTI-DATASET COMPARATIVE ANALYSIS")
        print(" "*15 + "MERLA vs PeMS Dataset Comparison")
        print("="*80)

        # Load datasets
        datasets = {
            'merla': DatasetProcessor('merla_dataset.csv', 'merla'),
            'pems': DatasetProcessor('pems_dataset.csv', 'pems')
        }

        data = {}
        for name, processor in datasets.items():
            data[name] = processor.load_and_preprocess()
            print(f"✓ Loaded {name.upper()}: {len(data[name])} samples")

        # Run experiments for each dataset
        for dataset_name, dataset in data.items():
            print(f"\n{'#'*80}")
            print(f"{'#'*80}")
            print(f" RUNNING EXPERIMENTS ON {dataset_name.upper()} DATASET")
            print(f"{'#'*80}")
            print(f"{'#'*80}")

            # Privacy experiment
            privacy_results = self.run_privacy_experiment(dataset, dataset_name)
            self.results[dataset_name]['privacy'] = privacy_results

            # Outage experiment
            outage_results = self.run_outage_experiment(dataset, dataset_name)
            self.results[dataset_name]['outage'] = outage_results

            # Non-IID experiment
            noniid_results = self.run_noniid_experiment(dataset, dataset_name)
            self.results[dataset_name]['noniid'] = noniid_results

        return self.results

    def create_comparison_visualizations(self):
        """Create comprehensive comparison visualizations"""
        fig = plt.figure(figsize=(20, 12))
        gs = fig.add_gridspec(3, 3, hspace=0.3, wspace=0.3)

