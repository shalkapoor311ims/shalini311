# FEDERATED LEARNING COMPONENTS
# ============================================================================

class FederatedClient:
    """Federated learning client"""

    def __init__(self, client_id, data, model, device='cpu'):
        self.client_id = client_id
        self.device = device
        self.model = model.to(device)

        X, y = create_sequences(data)
        self.X = torch.FloatTensor(X).to(device)
        self.y = torch.FloatTensor(y).unsqueeze(1).to(device)

        dataset = TensorDataset(self.X, self.y)
        self.data_loader = DataLoader(dataset, batch_size=32, shuffle=True)
        self.optimizer = torch.optim.Adam(self.model.parameters(), lr=0.001)
        self.active = True

    def train_local(self, epochs=5, mu=0.01, global_params=None):
        """Train with FedProx"""
        self.model.train()
        losses = []

        for epoch in range(epochs):
            epoch_loss = 0
            for batch_X, batch_y in self.data_loader:
                self.optimizer.zero_grad()
                output = self.model(batch_X)
                loss = F.mse_loss(output, batch_y)

                if global_params is not None:
                    proximal_term = 0
                    for local_param, global_param in zip(self.model.parameters(), global_params):
                        proximal_term += ((local_param - global_param) ** 2).sum()
                    loss += (mu / 2) * proximal_term

                loss.backward()
                self.optimizer.step()
                epoch_loss += loss.item()

            losses.append(epoch_loss / len(self.data_loader))

        return losses

    def get_parameters(self):
        return [param.data.clone() for param in self.model.parameters()]

    def set_parameters(self, parameters):
        for param, new_param in zip(self.model.parameters(), parameters):
            param.data = new_param.clone()


class FederatedServer:
    """Federated learning server"""

    def __init__(self, model, clients, device='cpu'):
        self.model = model.to(device)
        self.clients = clients
        self.device = device
        self.global_parameters = [p.data.clone() for p in self.model.parameters()]

    def aggregate_fednova(self, client_updates, client_steps):
        """FedNova aggregation"""
        total_steps = sum(client_steps)
        aggregated_params = []

        for param_idx in range(len(self.global_parameters)):
            weighted_sum = torch.zeros_like(self.global_parameters[param_idx])
            for client_params, steps in zip(client_updates, client_steps):
                weighted_sum += client_params[param_idx] * steps
            aggregated_params.append(weighted_sum / total_steps)

        self.global_parameters = aggregated_params
        for param, new_param in zip(self.model.parameters(), aggregated_params):
            param.data = new_param.clone()

    def train_round(self, num_clients_per_round=5, local_epochs=5):
        """Execute federated round"""
        active_clients = [c for c in self.clients if c.active]
        selected_clients = np.random.choice(
            active_clients,
            min(num_clients_per_round, len(active_clients)),
            replace=False
        )

        for client in selected_clients:
            client.set_parameters(self.global_parameters)

        client_updates = []
        client_steps = []

        for client in selected_clients:
            client.train_local(local_epochs, global_params=self.global_parameters)
            client_updates.append(client.get_parameters())
            client_steps.append(len(client.data_loader) * local_epochs)

        self.aggregate_fednova(client_updates, client_steps)

    def evaluate(self, test_data):
        """Evaluate model"""
        self.model.eval()
        X_test, y_test = create_sequences(test_data)
        X_test = torch.FloatTensor(X_test).to(self.device)
        y_test = torch.FloatTensor(y_test).unsqueeze(1).to(self.device)

        with torch.no_grad():
            predictions = self.model(X_test)

        predictions = predictions.cpu().numpy()
        y_test = y_test.cpu().numpy()

        mae = mean_absolute_error(y_test, predictions)
        rmse = np.sqrt(mean_squared_error(y_test, predictions))
        r2 = r2_score(y_test, predictions)

        return {'mae': mae, 'rmse': rmse, 'r2': r2}


