        ax2.set_ylabel('Performance Degradation (%)', fontsize=11, fontweight='bold')
        ax2.set_title('Privacy Cost Comparison', fontsize=13, fontweight='bold')
        ax2.set_xscale('log')
        ax2.legend(fontsize=10)
        ax2.grid(True, alpha=0.3)

        # R² scores
        ax3 = fig.add_subplot(gs[0, 2])
        x = np.arange(len(self.results['merla']['privacy']))
