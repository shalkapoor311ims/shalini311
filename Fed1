    def save_results(self, output_dir='./comparison_results'):
        """Save all results and visualizations"""
        os.makedirs(output_dir, exist_ok=True)

        # Save data tables
        for dataset_name in ['merla', 'pems']:
            for exp_name, exp_data in self.results[dataset_name].items():
                filename = f'{output_dir}/{dataset_name}_{exp_name}_results.csv'
                exp_data.to_csv(filename, index=False)

        # Save comparison visualization
        fig = self.create_comparison_visualizations()
        fig.savefig(f'{output_dir}/comprehensive_comparison.png',
                   dpi=300, bbox_inches='tight')

        # Create individual comparison plots
        self._save_individual_comparisons(output_dir)

        print(f"\n✓ All results saved to {output_dir}/")
        print(f"  • CSV files: {len(os.listdir(output_dir)) - 2} data files")
        print(f"  • Visualizations: comparison plots generated")

